<div class="svi-row{{#if done}} svi-done{{/if}}{{#if defeated}} svi-defeated{{/if}}{{#if hidden}} svi-hidden{{/if}}" data-combatant-id="{{id}}">
  {{#if img}}<img class="svi-portrait" src="{{img}}" alt="" loading="lazy">{{else}}<span class="svi-portrait" aria-hidden="true"></span>{{/if}}
  <div class="svi-name-col">
    <span class="svi-name">{{name}}</span>
    {{#if deferred}}<span class="svi-sub svi-deferred"><i class="fa-solid fa-clock-rotate-left" inert></i>{{deferred}}</span>{{/if}}
    {{#if noRoll}}<span class="svi-sub"><i class="fa-solid fa-dice-d20" inert></i>{{localize "SC_VENAERYS_INITIATIVE.Tracker.NoRoll"}}</span>{{/if}}
    {{#if skipButton}}<span class="svi-sub svi-when-done"><i class="fa-solid fa-forward" inert></i>{{localize "SC_VENAERYS_INITIATIVE.Tracker.Skipped"}}</span>{{/if}}
  </div>
  {{#if hidden}}<span class="svi-flag" role="img" aria-label="{{localize "SC_VENAERYS_INITIATIVE.Tracker.Hidden"}}" data-tooltip="{{localize "SC_VENAERYS_INITIATIVE.Tracker.Hidden"}}"><i class="fa-solid fa-eye-slash" inert></i></span>{{/if}}
  {{#if defeated}}<span class="svi-flag svi-flag-danger" role="img" aria-label="{{localize "SC_VENAERYS_INITIATIVE.Tracker.Defeated"}}" data-tooltip="{{localize "SC_VENAERYS_INITIATIVE.Tracker.Defeated"}}"><i class="fa-solid fa-skull" inert></i></span>{{/if}}
  {{#if pinned}}<span class="svi-flag svi-flag-accent" role="img" aria-label="{{localize "SC_VENAERYS_INITIATIVE.Tracker.Pinned"}}" data-tooltip="{{localize "SC_VENAERYS_INITIATIVE.Tracker.Pinned"}}"><i class="fa-solid fa-thumbtack" inert></i></span>{{/if}}
  <span class="svi-init"{{#if initiativeLabel}} role="img" aria-label="{{initiativeLabel}}" data-tooltip="{{initiativeLabel}}"{{/if}}>{{initiative}}</span>
  {{#if doneButton}}
  <button type="button" class="svi-done-btn{{#if doneButton.big}} svi-big{{/if}}" data-action="toggleDone"
          aria-pressed="{{doneButton.pressed}}" aria-label="{{doneButton.label}}" data-tooltip="{{doneButton.label}}">
    <i class="fa-regular fa-circle svi-when-todo" inert></i><i class="fa-solid fa-circle-check svi-when-done" inert></i>
    {{#if doneButton.big}}<span class="svi-when-todo">{{localize "SC_VENAERYS_INITIATIVE.Tracker.MarkDone"}}</span>{{else}}<span class="svi-when-todo">{{localize "SC_VENAERYS_INITIATIVE.Tracker.Done"}}</span>{{/if}}
    <span class="svi-when-done">{{localize "SC_VENAERYS_INITIATIVE.Tracker.Done"}}</span>
  </button>
  {{/if}}
  {{#if doneStatus}}
  <span class="svi-status">
    <span class="svi-when-done"><i class="fa-solid fa-circle-check" inert></i>{{localize "SC_VENAERYS_INITIATIVE.Tracker.Done"}}</span>
    <span class="svi-when-todo"><i class="fa-regular fa-circle" inert></i>{{localize "SC_VENAERYS_INITIATIVE.Tracker.Acting"}}</span>
  </span>
  {{/if}}
  {{#if skipButton}}
  <button type="button" class="svi-skip-btn" data-action="toggleDone"
          aria-pressed="{{skipButton.pressed}}" aria-label="{{skipButton.label}}" data-tooltip="{{skipButton.label}}">
    <i class="fa-solid fa-forward" inert></i>
  </button>
  {{/if}}
  {{#if select}}
  <select class="svi-phase-select" aria-label="{{select.label}}" data-tooltip="{{select.label}}">
    {{#each select.options}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}
  </select>
  {{/if}}
</div>
