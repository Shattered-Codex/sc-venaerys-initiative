<div class="svi-header">
  {{#if hasCombat}}
  <div class="svi-round-row">
    <span class="svi-round">{{#if started}}{{roundLabel}}{{else}}{{localize "SC_VENAERYS_INITIATIVE.Tracker.NotStarted"}}{{/if}}</span>
    {{#if started}}<span class="svi-tag"><i class="{{stateIcon}}" inert></i>{{stateLabel}}</span>{{/if}}
    <span class="svi-spacer"></span>
    {{#if dc}}{{#unless gm}}<span class="svi-dc-badge">{{dc.text}}</span>{{/unless}}{{/if}}
  </div>

  {{#if gm}}
  <div class="svi-gm-panel">
    <div class="svi-gm-line">
      <div class="svi-switch-wrap">
        <button type="button" class="svi-switch" role="switch" data-action="togglePhases"
                aria-checked="{{gm.phasesOn}}" aria-label="{{localize "SC_VENAERYS_INITIATIVE.Gm.PhasesToggle"}}"
                {{#unless gm.phasesEditable}}disabled aria-disabled="true" aria-describedby="svi-phases-locked"{{/unless}}>
          <span class="svi-switch-track" aria-hidden="true"><span class="svi-switch-knob"></span></span>
          <span>{{#if gm.phasesOn}}{{localize "SC_VENAERYS_INITIATIVE.Gm.PhasesOn"}}{{else}}{{localize "SC_VENAERYS_INITIATIVE.Gm.PhasesOff"}}{{/if}}</span>
        </button>
        {{#unless gm.phasesEditable}}
        <span class="svi-hint" id="svi-phases-locked" data-tooltip="{{localize "SC_VENAERYS_INITIATIVE.Gm.PhasesLockedHint"}}">
          <i class="fa-solid fa-lock" inert></i>{{localize "SC_VENAERYS_INITIATIVE.Gm.PhasesLocked"}}
        </span>
        {{/unless}}
      </div>
      <span class="svi-spacer"></span>
      {{#if gm.phasesOn}}
      <div class="svi-stepper" role="group" aria-label="{{localize "SC_VENAERYS_INITIATIVE.Gm.DcInput"}}">
        <button type="button" data-action="stepDc" data-step="-1" aria-label="{{localize "SC_VENAERYS_INITIATIVE.Gm.DcDown"}}"><i class="fa-solid fa-minus" inert></i></button>
        <label class="svi-stepper-value">
          <span class="svi-muted">{{localize "SC_VENAERYS_INITIATIVE.Tracker.DcShort"}}</span>
          <input type="number" name="dc" value="{{gm.dc}}" step="1" aria-label="{{localize "SC_VENAERYS_INITIATIVE.Gm.DcInput"}}">
        </label>
        <button type="button" data-action="stepDc" data-step="1" aria-label="{{localize "SC_VENAERYS_INITIATIVE.Gm.DcUp"}}"><i class="fa-solid fa-plus" inert></i></button>
      </div>
      {{/if}}
    </div>

    {{#if gm.phasesOn}}
    <div class="svi-gm-controls">
      <button type="button" class="svi-btn svi-btn-primary {{#if gm.advanceStrong}}svi-strong{{/if}}" data-action="advance"
              aria-label="{{gm.advanceLabel}}" data-tooltip="{{gm.advanceLabel}}" {{#if gm.controlsDisabled}}disabled aria-disabled="true"{{/if}}>
        <i class="fa-solid fa-forward-step" inert></i><span>{{localize "SC_VENAERYS_INITIATIVE.Gm.Advance"}}</span>
      </button>
      <button type="button" class="svi-btn" data-action="complete"
              aria-label="{{gm.completeLabel}}" data-tooltip="{{gm.completeLabel}}" {{#if gm.controlsDisabled}}disabled aria-disabled="true"{{/if}}>
        <i class="fa-solid fa-check-double" inert></i><span>{{localize "SC_VENAERYS_INITIATIVE.Gm.Complete"}}</span>
      </button>
      <button type="button" class="svi-btn svi-icon-btn" data-action="back"
              aria-label="{{gm.backLabel}}" data-tooltip="{{gm.backLabel}}" {{#if gm.controlsDisabled}}disabled aria-disabled="true"{{/if}}>
        <i class="fa-solid fa-rotate-left" inert></i>
      </button>
      <button type="button" class="svi-btn svi-icon-btn" data-action="help"
              aria-label="{{localize "SC_VENAERYS_INITIATIVE.Gm.Help"}}" data-tooltip="{{localize "SC_VENAERYS_INITIATIVE.Gm.Help"}}">
        <i class="fa-solid fa-circle-question" inert></i>
      </button>
    </div>
    {{#unless started}}<p class="svi-hint svi-hint-block">{{localize "SC_VENAERYS_INITIATIVE.Gm.NotStartedHint"}}</p>{{/unless}}
    {{/if}}

    {{#each gm.warnings}}
    <div class="svi-warning" role="status">
      <div class="svi-warning-title"><i class="{{icon}}" inert></i><span>{{text}}</span></div>
      {{#if hint}}<p class="svi-warning-hint">{{hint}}</p>{{/if}}
      {{#if action}}
      <button type="button" class="svi-btn svi-btn-primary svi-small" data-action="{{action.name}}" data-tooltip="{{hint}}">
        <i class="fa-solid fa-forward" inert></i><span>{{action.label}}</span>
      </button>
      {{/if}}
    </div>
    {{/each}}
  </div>
  {{/if}}
  {{/if}}
</div>
