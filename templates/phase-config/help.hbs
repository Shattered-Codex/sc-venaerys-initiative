<div class="tab svi-tab-panel {{tab.cssClass}}" data-group="primary" data-tab="help" role="tabpanel">
  {{#each help}}
  <details class="svi-help-topic"{{#if open}} open{{/if}}>
    <summary><i class="{{icon}}" inert></i><span>{{localize title}}</span></summary>
    <p>{{localize body}}</p>
  </details>
  {{/each}}
</div>
