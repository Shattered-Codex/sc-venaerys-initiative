<section class="svi-config-panel" data-tab-panel="{{ tab.id }}" role="tabpanel" {{#unless tab.active}}hidden{{/unless}}>
  <header class="svi-panel-head">
    <h2 class="svi-panel-title">{{ localize tab.title }}</h2>
    <p class="svi-panel-hint">{{ localize tab.hint }}</p>
  </header>
  {{#each sections}}
  {{#if showTitle}}<h3 class="svi-section-title">{{ localize title }}</h3>{{/if}}
  <div class="svi-rows">
    {{#each rows}}
    <label class="svi-setting" for="svi-setting-{{ key }}">
      <span class="svi-setting-text">
        <span class="svi-setting-name">{{ name }}</span>
        <span class="svi-setting-hint">{{ hint }}{{#if range}} · {{ range }}{{/if}}</span>
      </span>
      <span class="svi-setting-control">
        {{#if isToggle}}
        <span class="svi-check">
          <input type="checkbox" id="svi-setting-{{ key }}" data-setting="{{ key }}" data-default="{{ defaultValue }}"{{#if value}} checked{{/if}}>
          <span class="svi-check-box" aria-hidden="true"><i class="fa-solid fa-check" inert></i></span>
        </span>
        {{/if}}
        {{#if isSelect}}
        <span class="svi-select-wrap">
          <select class="svi-select" id="svi-setting-{{ key }}" data-setting="{{ key }}" data-default="{{ defaultValue }}">
            {{#each choices}}<option value="{{ value }}"{{#if selected}} selected{{/if}}>{{ label }}</option>{{/each}}
          </select>
          <i class="fa-solid fa-chevron-down svi-select-chev" inert></i>
        </span>
        {{/if}}
        {{#if isText}}
        <input type="text" class="svi-input svi-input-text" id="svi-setting-{{ key }}" data-setting="{{ key }}" data-default="{{ defaultValue }}" value="{{ value }}" placeholder="{{ placeholder }}" spellcheck="false">
        {{/if}}
        {{#if isNumber}}
        <input type="number" class="svi-input svi-input-number" id="svi-setting-{{ key }}" data-setting="{{ key }}" data-default="{{ defaultValue }}" value="{{ value }}" min="{{ min }}" max="{{ max }}" step="{{ step }}">
        {{/if}}
      </span>
    </label>
    {{/each}}
  </div>
  {{/each}}
</section>
