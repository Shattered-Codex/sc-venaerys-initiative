<section class="svi-config-panel" data-tab-panel="{{ tab.id }}" role="tabpanel" {{#unless tab.active}}hidden{{/unless}}>
  <header class="svi-panel-head">
    <h2 class="svi-panel-title">{{ localize tab.title }}</h2>
    <p class="svi-panel-hint">{{ localize tab.hint }}</p>
  </header>
  <div class="svi-appearance">
  <div class="svi-appearance-options">
    <label class="svi-appearance-field" for="svi-setting-theme">
      <span class="svi-setting-name">{{ localize "SC_VENAERYS_INITIATIVE.Settings.theme.Name" }}</span>
      <span class="svi-select-wrap">
        <select class="svi-select" id="svi-setting-theme" data-setting="theme" data-default="{{ themeDefault }}">
          {{#each families}}
          <optgroup label="{{ localize label }}">
            {{#each themes}}<option value="{{ id }}"{{#if selected}} selected{{/if}}>{{ localize label }}</option>{{/each}}
          </optgroup>
          {{/each}}
        </select>
        <i class="fa-solid fa-chevron-down svi-select-chev" inert></i>
      </span>
      <span class="svi-setting-hint">{{ localize "SC_VENAERYS_INITIATIVE.Settings.theme.Hint" }}</span>
    </label>
    {{!-- Shown while the select above says "Custom". --}}
    <fieldset class="svi-custom-colors">
      <legend>{{ localize "SC_VENAERYS_INITIATIVE.Config.Appearance.CustomTitle" }}</legend>
      {{#each customColors}}
      <label class="svi-color-field" for="{{ id }}" data-tooltip="{{ localize hint }}">
        <input type="color" id="{{ id }}" data-setting="{{ key }}" data-custom-color="true" data-default="{{ fallback }}" value="{{ value }}">
        <span>{{ localize label }}</span>
      </label>
      {{/each}}
      <p class="svi-setting-hint">{{ localize "SC_VENAERYS_INITIATIVE.Config.Appearance.CustomHint" }}</p>
    </fieldset>
  </div>

  {{!-- A specimen of the phased combat tracker, painted by the same tokens; inert and outside the form. --}}
  <div class="svi-theme-preview" aria-hidden="true" inert>
    <div class="svi-theme-preview-bar"><i class="fa-solid fa-swords"></i><span>{{ localize "SC_VENAERYS_INITIATIVE.Config.Appearance.PreviewTitle" }}</span></div>
    <div class="svi-theme-preview-body">
      <div class="svi-theme-preview-phase svi-is-current">
        <span class="svi-theme-preview-icon"><i class="fa-solid fa-bolt"></i></span>
        <span class="svi-theme-preview-name">{{ localize "SC_VENAERYS_INITIATIVE.Phase.Fast" }}</span>
        <span class="svi-theme-preview-now"><i class="fa-solid fa-play"></i>{{ localize "SC_VENAERYS_INITIATIVE.Tracker.Now" }}</span>
        <span class="svi-theme-preview-count">1/2</span>
      </div>
      <div class="svi-theme-preview-row">
        <span class="svi-theme-preview-avatar"></span><span class="svi-theme-preview-text">Ana</span>
        <span class="svi-theme-preview-done"><i class="fa-solid fa-circle-check"></i>{{ localize "SC_VENAERYS_INITIATIVE.Tracker.Done" }}</span>
      </div>
      <div class="svi-theme-preview-row">
        <span class="svi-theme-preview-avatar"></span><span class="svi-theme-preview-text">Bruno</span>
        <span class="svi-theme-preview-todo"><i class="fa-regular fa-circle"></i>{{ localize "SC_VENAERYS_INITIATIVE.Tracker.MarkDone" }}</span>
      </div>
      <div class="svi-theme-preview-phase">
        <span class="svi-theme-preview-icon"><i class="fa-solid fa-users"></i></span>
        <span class="svi-theme-preview-name">{{ localize "SC_VENAERYS_INITIATIVE.Phase.Enemies" }}</span>
      </div>
      <div class="svi-theme-preview-actions">
        <span class="svi-btn svi-btn-primary"><i class="fa-solid fa-forward-step"></i>{{ localize "SC_VENAERYS_INITIATIVE.Gm.Advance" }}</span>
        <span class="svi-btn"><i class="fa-solid fa-check-double"></i>{{ localize "SC_VENAERYS_INITIATIVE.Gm.Complete" }}</span>
      </div>
    </div>
  </div>
  </div>
  <p class="svi-preview-note" role="status" hidden><i class="fa-solid fa-circle-info" inert></i><span class="svi-preview-note-label"></span></p>
</section>
