<section class="svi-config-panel svi-phases-panel" data-tab-panel="{{ tab.id }}" role="tabpanel" {{#unless tab.active}}hidden{{/unless}}>
  <header class="svi-panel-head">
    <h2 class="svi-panel-title">{{ localize tab.title }}</h2>
    <p class="svi-panel-hint">{{ localize tab.hint }}</p>
  </header>
  <ol class="svi-phase-list">
    {{#each phases}}
    {{#if bandStart}}<li class="svi-band-label" aria-hidden="true"><i class="fa-solid fa-people-group" inert></i>{{localize "SC_VENAERYS_INITIATIVE.Config.Phases.Band"}}</li>{{/if}}
    <li class="svi-phase-item{{#if inBand}} svi-in-band{{/if}}{{#if flash}} svi-flash{{/if}}" data-id="{{id}}">
      <div class="svi-phase-line" style="--svi-phase-color: {{color}}">
        <span class="svi-drag" role="img" aria-label="{{dragLabel}}" data-tooltip="{{dragLabel}}"><i class="fa-solid fa-grip-vertical" inert></i></span>
        {{#if builtin}}
        <span class="svi-phase-icon" aria-hidden="true"><i class="{{icon}}"></i></span>
        <span class="svi-builtin-name">{{name}}
          <span class="svi-flag" role="img" aria-label="{{localize "SC_VENAERYS_INITIATIVE.Config.Phases.Builtin"}}" data-tooltip="{{localize "SC_VENAERYS_INITIATIVE.Config.Phases.BuiltinHint"}}"><i class="fa-solid fa-lock" inert></i></span>
        </span>
        {{else}}
        <details class="svi-look">
          <summary class="svi-phase-icon" aria-label="{{iconLabel}}" data-tooltip="{{iconLabel}}"><i class="{{icon}}" inert></i></summary>
          <div class="svi-look-popover">
            <span class="svi-look-title">{{localize "SC_VENAERYS_INITIATIVE.Config.Phases.IconTitle"}}</span>
            <div class="svi-look-grid" role="radiogroup" aria-label="{{iconLabel}}">
              {{#each icons}}
              <button type="button" role="radio" aria-checked="{{selected}}" data-action="pickIcon" data-icon="{{cls}}" aria-label="{{label}}" data-tooltip="{{label}}"><i class="{{cls}}" inert></i></button>
              {{/each}}
            </div>
            <span class="svi-look-title">{{localize "SC_VENAERYS_INITIATIVE.Config.Phases.ColorTitle"}}</span>
            <div class="svi-look-grid" role="radiogroup" aria-label="{{localize "SC_VENAERYS_INITIATIVE.Config.Phases.ColorTitle"}}">
              {{#each colors}}
              <button type="button" role="radio" class="svi-swatch" aria-checked="{{selected}}" data-action="pickColor" data-color="{{hex}}" aria-label="{{label}}" data-tooltip="{{label}}" style="--svi-swatch: {{hex}}"><i class="fa-solid fa-check" inert></i></button>
              {{/each}}
            </div>
          </div>
        </details>
        <input type="text" class="svi-phase-name-input{{#if error}} svi-invalid{{/if}}" value="{{name}}" placeholder="{{localize "SC_VENAERYS_INITIATIVE.Config.Phases.NamePlaceholder"}}"
               aria-label="{{localize "SC_VENAERYS_INITIATIVE.Config.Phases.NameLabel"}}" {{#if error}}aria-invalid="true" aria-describedby="svi-error-{{id}}"{{/if}}>
        {{/if}}
        {{#if event}}<span class="svi-event-badge" data-tooltip="{{localize "SC_VENAERYS_INITIATIVE.Config.Phases.EventHint"}}"><i class="fa-solid fa-flag" inert></i>{{localize "SC_VENAERYS_INITIATIVE.Config.Phases.Event"}}</span>{{/if}}
        <button type="button" class="svi-icon-btn" data-action="movePhase" data-step="-1" aria-label="{{upLabel}}" data-tooltip="{{upLabel}}" {{#unless canUp}}disabled{{/unless}}><i class="fa-solid fa-arrow-up" inert></i></button>
        <button type="button" class="svi-icon-btn" data-action="movePhase" data-step="1" aria-label="{{downLabel}}" data-tooltip="{{downLabel}}" {{#unless canDown}}disabled{{/unless}}><i class="fa-solid fa-arrow-down" inert></i></button>
        {{#if builtin}}<span class="svi-icon-spacer" aria-hidden="true"></span>
        {{else}}<button type="button" class="svi-icon-btn svi-danger" data-action="deletePhase" aria-label="{{deleteLabel}}" data-tooltip="{{deleteLabel}}"><i class="fa-solid fa-trash" inert></i></button>{{/if}}
      </div>
      {{#if error}}<p class="svi-error" id="svi-error-{{id}}" role="alert"><i class="fa-solid fa-circle-exclamation" inert></i>{{localize "SC_VENAERYS_INITIATIVE.Config.Phases.NameEmpty"}}</p>{{/if}}
      <details class="svi-actions"{{#if actions.open}} open{{/if}}>
        <summary>
          <i class="fa-solid fa-bolt-lightning" inert></i>
          <span>{{localize "SC_VENAERYS_INITIATIVE.Automation.Title"}}</span>
          <span class="svi-actions-count">{{#if actions.count}}{{localize actions.countLabel}}{{else}}{{localize "SC_VENAERYS_INITIATIVE.Automation.Empty"}}{{/if}}</span>
        </summary>
        <div class="svi-actions-body">
          <p class="svi-actions-note"><i class="fa-solid fa-circle-info" inert></i>{{localize "SC_VENAERYS_INITIATIVE.Automation.Note"}}</p>
          {{#each actions.rows}}
          <div class="svi-action-row" data-action-id="{{id}}">
            <div class="svi-action-head">
              <i class="{{icon}}" inert></i>
              <span class="svi-action-name">{{localize label}}</span>
              <span class="svi-action-where">{{localize where}}</span>
              <span class="svi-spacer"></span>
              <label class="svi-check" data-tooltip="{{localize "SC_VENAERYS_INITIATIVE.Automation.Enabled"}}">
                <input type="checkbox" data-action-field="enabled" aria-label="{{localize "SC_VENAERYS_INITIATIVE.Automation.Enabled"}}"{{#if enabled}} checked{{/if}}>
                <span class="svi-check-box" aria-hidden="true"><i class="fa-solid fa-check" inert></i></span>
              </label>
              <button type="button" class="svi-icon-btn" data-action="moveAction" data-step="-1" aria-label="{{localize "SC_VENAERYS_INITIATIVE.Automation.MoveUp"}}" data-tooltip="{{localize "SC_VENAERYS_INITIATIVE.Automation.MoveUp"}}" {{#unless canUp}}disabled{{/unless}}><i class="fa-solid fa-arrow-up" inert></i></button>
              <button type="button" class="svi-icon-btn" data-action="moveAction" data-step="1" aria-label="{{localize "SC_VENAERYS_INITIATIVE.Automation.MoveDown"}}" data-tooltip="{{localize "SC_VENAERYS_INITIATIVE.Automation.MoveDown"}}" {{#unless canDown}}disabled{{/unless}}><i class="fa-solid fa-arrow-down" inert></i></button>
              <button type="button" class="svi-icon-btn svi-danger" data-action="deleteAction" aria-label="{{localize "SC_VENAERYS_INITIATIVE.Automation.Delete"}}" data-tooltip="{{localize "SC_VENAERYS_INITIATIVE.Automation.Delete"}}"><i class="fa-solid fa-trash" inert></i></button>
            </div>
            <div class="svi-action-fields">
              {{#each fields}}
              <label class="svi-action-field">
                <span>{{localize label}}</span>
                {{#if isText}}<input type="text" data-action-field="{{name}}" value="{{value}}">{{/if}}
                {{#if isTextarea}}<textarea data-action-field="{{name}}" rows="2">{{value}}</textarea>{{/if}}
                {{#if isNumber}}<input type="number" data-action-field="{{name}}" value="{{value}}" min="{{min}}" max="{{max}}">{{/if}}
                {{#if isSelect}}<select data-action-field="{{name}}">{{#each choices}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}
                {{#if isMacro}}<select data-action-field="{{name}}"><option value="">{{localize "SC_VENAERYS_INITIATIVE.Automation.NoMacro"}}</option>{{#each macros}}<option value="{{value}}"{{#if selected}} selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}
                {{#if isUuid}}<input type="text" data-action-field="{{name}}" data-drop-uuid value="{{value}}" placeholder="{{localize "SC_VENAERYS_INITIATIVE.Automation.DropHint"}}">{{/if}}
                {{#if isFile}}
                <span class="svi-file-field">
                  <input type="text" data-action-field="{{name}}" value="{{value}}">
                  <button type="button" class="svi-icon-btn" data-action="pickFile" aria-label="{{localize "SC_VENAERYS_INITIATIVE.Automation.PickFile"}}" data-tooltip="{{localize "SC_VENAERYS_INITIATIVE.Automation.PickFile"}}"><i class="fa-solid fa-file-audio" inert></i></button>
                </span>
                {{/if}}
              </label>
              {{/each}}
            </div>
          </div>
          {{/each}}
          <select class="svi-add-action svi-select" aria-label="{{localize "SC_VENAERYS_INITIATIVE.Automation.Add"}}">
            <option value="">{{localize "SC_VENAERYS_INITIATIVE.Automation.Add"}}</option>
            {{#each actions.kinds}}<option value="{{id}}"{{#if disabled}} disabled title="{{title}}"{{/if}}>{{localize label}}{{#if disabled}} ({{title}}){{/if}}</option>{{/each}}
          </select>
        </div>
      </details>
    </li>
    {{/each}}
  </ol>
  <div class="svi-phase-actions">
    <button type="button" class="svi-btn" data-action="addPhase"><i class="fa-solid fa-plus" inert></i><span>{{localize "SC_VENAERYS_INITIATIVE.Config.Phases.Add"}}</span></button>
    <button type="button" class="svi-btn" data-action="addEventPhase" data-tooltip="{{localize "SC_VENAERYS_INITIATIVE.Config.Phases.EventHint"}}"><i class="fa-solid fa-flag" inert></i><span>{{localize "SC_VENAERYS_INITIATIVE.Config.Phases.AddEvent"}}</span></button>
  </div>
</section>
