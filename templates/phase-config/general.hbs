<div class="tab svi-tab-panel {{tab.cssClass}}" data-group="primary" data-tab="general" role="tabpanel">
  {{#each sections}}
  <section class="svi-section">
    <h3 class="svi-section-title">{{localize title}}</h3>
    {{#each rows}}
    <div class="svi-setting">
      <div class="svi-setting-text">
        <span class="svi-setting-name" id="svi-setting-{{key}}">{{name}}</span>
        <span class="svi-setting-hint">{{hint}}</span>
        <span class="svi-setting-scope"><i class="{{scopeIcon}}" inert></i>{{scopeLabel}}</span>
      </div>
      {{#if isToggle}}
      <button type="button" class="svi-switch" role="switch" data-action="toggleSetting" data-setting="{{key}}"
              aria-checked="{{on}}" aria-labelledby="svi-setting-{{key}}">
        <span class="svi-switch-state">{{stateLabel}}</span>
        <span class="svi-switch-track" aria-hidden="true"><span class="svi-switch-knob"></span></span>
      </button>
      {{/if}}
      {{#if isNumber}}
      <div class="svi-stepper" role="group" aria-labelledby="svi-setting-{{key}}">
        <button type="button" data-action="stepSetting" data-setting="{{key}}" data-step="-1" aria-label="{{decreaseLabel}}"><i class="fa-solid fa-minus" inert></i></button>
        <input type="number" data-setting="{{key}}" value="{{value}}" min="{{range.min}}" max="{{range.max}}" step="{{range.step}}" aria-labelledby="svi-setting-{{key}}">
        <button type="button" data-action="stepSetting" data-setting="{{key}}" data-step="1" aria-label="{{increaseLabel}}"><i class="fa-solid fa-plus" inert></i></button>
      </div>
      {{/if}}
    </div>
    {{/each}}
  </section>
  {{/each}}
  <footer class="svi-footer">
    <span class="svi-spacer"></span>
    <button type="button" class="svi-btn svi-btn-primary" data-action="saveGeneral"><i class="fa-solid fa-floppy-disk" inert></i><span>{{localize "SC_VENAERYS_INITIATIVE.Config.Save"}}</span></button>
  </footer>
</div>
