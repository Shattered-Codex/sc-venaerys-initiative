<ol class="combat-tracker plain svi-phased-tracker">
    {{#each sviPhases}}
    {{#if waitingForGm}}
    <li class="sc-venaerys-initiative svi-waiting" data-theme="{{ @root.sviTheme }}" role="status">
        <i class="fa-solid fa-hourglass-half" inert></i><span>{{ label }}</span>
    </li>
    {{else}}
    <li class="sc-venaerys-initiative svi-phase svi-state-{{ state }}{{#if isEmpty}} svi-phase-empty{{/if}}{{#if complete}} svi-complete{{/if}}"
        data-theme="{{ @root.sviTheme }}" data-phase-id="{{ id }}" style="--svi-phase-color: {{ color }}" aria-label="{{ name }}"{{#if isCurrent}} aria-current="step"{{/if}}>
        <header class="svi-phase-header">
            <span class="svi-phase-icon" aria-hidden="true"><i class="{{ icon }}"></i></span>
            <span class="svi-phase-name">{{ name }}</span>
            {{#if isCurrent}}<span class="svi-now"><i class="fa-solid fa-play" inert></i>{{ nowLabel }}</span>{{/if}}
            {{#if isPast}}{{#unless isEmpty}}<span class="svi-flag" role="img" aria-label="{{ pastLabel }}" data-tooltip="{{ pastLabel }}"><i class="fa-solid fa-circle-check" inert></i></span>{{/unless}}{{/if}}
            {{#if isEmpty}}<span class="svi-empty-label">{{ emptyLabel }}</span>{{/if}}
            <span class="svi-spacer"></span>
            {{#if isEmpty}}<span class="svi-gm-only"><i class="fa-solid fa-eye" inert></i>{{ gmOnlyLabel }}</span>{{/if}}
            {{#if count}}<span class="svi-count" data-phase-count="{{ id }}">{{ count }}</span>{{/if}}
            {{#if addMarker}}
            <button type="button" class="svi-icon-btn svi-add-marker" data-action="sviAddMarker" data-phase-id="{{ id }}"
                    aria-label="{{ addMarker.label }}" data-tooltip="{{ addMarker.label }}">
                <i class="fa-solid fa-plus" inert></i>
            </button>
            {{/if}}
            {{#if pastToggle}}
            <button type="button" class="svi-chevron" data-action="sviToggleExpand" data-key="{{ pastToggle.key }}"
                    aria-expanded="{{ pastToggle.expanded }}" aria-label="{{ pastToggle.label }}" data-tooltip="{{ pastToggle.label }}">
                <i class="fa-solid {{#if pastToggle.expanded}}fa-chevron-up{{else}}fa-chevron-down{{/if}}" inert></i>
            </button>
            {{/if}}
        </header>
        {{#if compact}}
        <p class="svi-compact">{{ compact }}</p>
        {{else}}
        {{#unless isEmpty}}
        <ol class="plain svi-members">
            {{#each rows}}
            {{#if isGroup}}
            <li class="svi-group" data-group-key="{{ key }}">
                <div class="svi-group-row">
                    <button type="button" class="svi-chevron" data-action="sviToggleExpand" data-key="{{ key }}"
                            aria-expanded="{{ expanded }}" aria-label="{{ toggleLabel }}" data-tooltip="{{ toggleLabel }}">
                        <i class="fa-solid {{#if expanded}}fa-chevron-down{{else}}fa-chevron-right{{/if}}" inert></i>
                    </button>
                    {{#if img}}<img class="svi-portrait" src="{{ img }}" alt="" loading="lazy">{{/if}}
                    <span class="svi-name">{{ name }}</span>
                    <span class="svi-group-count">{{ count }}</span>
                    {{#if completeButton}}
                    <button type="button" class="svi-icon-btn svi-complete-group" data-action="sviCompleteGroup" data-key="{{ key }}"
                            aria-label="{{ completeButton.label }}" data-tooltip="{{ completeButton.label }}">
                        <i class="fa-solid fa-check-double" inert></i>
                    </button>
                    {{/if}}
                </div>
                {{#if expanded}}
                <ol class="plain svi-children">{{#each children}}{{> "modules/sc-venaerys-initiative/templates/combat-tracker/row.hbs"}}{{/each}}</ol>
                {{/if}}
            </li>
            {{else}}
            {{> "modules/sc-venaerys-initiative/templates/combat-tracker/row.hbs"}}
            {{/if}}
            {{/each}}
        </ol>
        {{/unless}}
        {{/if}}
    </li>
    {{/if}}
    {{/each}}

    {{#if svi.hasPending}}
    <li class="sc-venaerys-initiative svi-phase svi-pending" data-theme="{{ @root.sviTheme }}" aria-label="{{ localize "SC_VENAERYS_INITIATIVE.Tracker.AwaitingRoll" }}">
        <header class="svi-phase-header">
            <span class="svi-phase-icon" aria-hidden="true"><i class="fa-solid fa-dice-d20"></i></span>
            <span class="svi-phase-name">{{ localize "SC_VENAERYS_INITIATIVE.Tracker.AwaitingRoll" }}</span>
            <span class="svi-spacer"></span>
            <span class="svi-count">{{ svi.pendingCount }}</span>
        </header>
        <ol class="plain svi-members">
            {{#each sviPending}}
            {{> "modules/sc-venaerys-initiative/templates/combat-tracker/row.hbs"}}
            {{/each}}
        </ol>
    </li>
    {{/if}}
</ol>
